# ============================================================================
# Anime World India Stremio Addon - .env.example
# Copy to `.env` and edit. Only TMDB_API_KEY is strictly required.
# ============================================================================

# ----------------------------------------------------------------------------
# Flask
# ----------------------------------------------------------------------------
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_DEBUG=False

# ----------------------------------------------------------------------------
# TMDB (REQUIRED) - get a free key at https://www.themoviedb.org/settings/api
# Used to map IMDB ids (Stremio's content ids) to slugs on watchanimeworld.
# ----------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_api_key_here

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
DB_TYPE=sqlite
DB_PATH=mappings.db
# For PostgreSQL instead:
# DB_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ----------------------------------------------------------------------------
# STREAM MODE - the "no-proxy" smart switch
#   direct   (DEFAULT) -> Return upstream play.zephyrflick.top URLs directly
#                         with behaviorHints.proxyHeaders. Stremio desktop /
#                         mobile / web+streaming-server fetch the video
#                         themselves. Addon relays ZERO video bytes.
#   proxy    (legacy)  -> Route HLS through this addon's /cdn/hls/... routes.
#                         Required only for Stremio Web users who do NOT have
#                         the local Stremio Streaming Server running.
#   auto              -> Per-request: desktop/mobile UA -> direct,
#                         browser UA -> proxy. Best of both worlds.
# ----------------------------------------------------------------------------
STREAM_MODE=direct

# Whether the /cdn/hls and /subtitles proxy routes are mounted at all.
# Leave "1" if you ever fall back to proxy mode; set "0" to fully remove them.
ENABLE_PROXY_ROUTES=1

# ----------------------------------------------------------------------------
# OPTIONAL - MediaFlow proxy for scraping watchanimeworld.net
# Only needed if your addon server's IP is geo-blocked / Cloudflare-challenged
# by the scraper. Leave empty to scrape directly (works for most IPs).
# ----------------------------------------------------------------------------
# SCRAPER_PROXY_URL=https://your-mediaflow-instance.example.com
# SCRAPER_PROXY_PASSWORD=your_mediaflow_password

# ----------------------------------------------------------------------------
# OPTIONAL - upstream domain overrides (in case the site renames again)
#   Defaults below are the current live values as of writing.
# ----------------------------------------------------------------------------
WAW_BASE_URL=https://watchanimeworld.top
ZEPHYR_PLAYER_BASE=https://play.zephyrix.top

# ----------------------------------------------------------------------------
# OPTIONAL - explicit public URL override
# The addon auto-detects its public URL from the Host / X-Forwarded-Host
# headers, so you usually DON'T need to set this. Use it only if you're
# behind a reverse proxy that hides the real hostname, or if you want to
# force a specific URL in the "Install in Stremio" button.
# Example: FORCE_BASE_URL=https://my-custom-domain.com
# ----------------------------------------------------------------------------
# FORCE_BASE_URL=
